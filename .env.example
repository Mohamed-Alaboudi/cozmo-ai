# ── Optional: live "Cozmo calls you" demo ───────────────────────────────
# Wire any voice provider (ElevenLabs/Vapi/Retell/Bland). Without these the
# call form works but gracefully tells the visitor to dial the demo line.
VOICE_API_KEY=
VOICE_AGENT_ID=
VOICE_AGENT_PHONE_ID=

# ── Optional: embedded "Book a demo" calendar ───────────────────────────
# A Calendly event URL. Without it, the demo section shows a tasteful
# "email us" fallback instead of the inline scheduler.
NEXT_PUBLIC_CALENDLY_URL=
